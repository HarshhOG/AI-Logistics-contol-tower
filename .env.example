# ==============================================================================
# AI LOGISTICS CONTROL TOWER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String
# Use Connection Pooling URI (port 6543) or Direct URI (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Project API Credentials (from Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. FRONTEND VITE CONFIGURATION (Set in Vercel Environment Variables)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Leave empty on Vercel to use relative /api
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 3. OPTIONAL EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Maps & Routing (calibrated Indian freight highway network + OpenStreetMap fallback active by default)
MAPS_API_KEY=
ROUTING_PROVIDER=osrm_fallback
GEOCODING_PROVIDER=nominatim_fallback

# Grounded AI Assistant (Gemini API Key)
LLM_API_KEY=

# Company TMS Ingestion API (Optional live sync)
COMPANY_TMS_API_URL=
COMPANY_TMS_API_KEY=
